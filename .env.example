# Copy this file to .env before starting:   cp .env.example .env
# .env is ignored by Git. Only this example file (with dummy values) is committed.

# --- PostgreSQL (used by the db container and by the app) ---
POSTGRES_USER=pawdonor
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_DB=pawdonor

# --- Ports published on your machine ---
# PawDonor -> http://localhost:3002
APP_PORT=3002
# Adminer -> http://localhost:8080 (only started with --profile tools)
ADMINER_PORT=8080
